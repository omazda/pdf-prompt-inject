# Учебные файлы demo/ — часть инструкции, их ищут по ссылкам из demo/README.md
!demo/**/*.docx
!demo/**/*.doc
!demo/**/*.pdf

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Отчёты проверки
*.log
/tmp/
